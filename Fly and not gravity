
-- MINI CAR FLIGHT CONTROL
-- Keybinds configuraveis
-- Camera + WASD + estabilizacao

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local old = PlayerGui:FindFirstChild("MiniFlightControl")
if old then old:Destroy() end

local Keys = {
    GUI = Enum.KeyCode.G,
    Gravity = Enum.KeyCode.H,
    Fly = Enum.KeyCode.F
}

local Capturing = nil
local GravityEnabled = false
local OriginalGravity = workspace.Gravity
local Flying = false

local FlySpeed = 100
local CurrentCar = nil
local CurrentRoot = nil

local Attachment = nil
local LinearVelocity = nil
local AlignOrientation = nil
local AntiGravity = nil

local LastLook = Vector3.new(0, 0, -1)

-- LOCALIZAR CARRO

local function getCar()
    local character = Player.Character
    if not character then return nil end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or not humanoid.SeatPart then
        return nil
    end

    local seat = humanoid.SeatPart
    local current = seat

    while current and current ~= workspace do
        if current.Parent and current.Parent.Name == "Cars" then
            return current
        end

        if current:FindFirstChild("Stats") then
            return current
        end

        current = current.Parent
    end

    return nil
end

local function getRoot(car)
    if not car then return nil end

    local seat = Player.Character
        and Player.Character:FindFirstChildOfClass("Humanoid")
        and Player.Character:FindFirstChildOfClass("Humanoid").SeatPart

    return car:FindFirstChild("DriveSeat")
        or car.PrimaryPart
        or seat
        or car:FindFirstChildWhichIsA("BasePart", true)
end

-- REMOVER CONTROLES DE VOO

local function removeFlight()
    if LinearVelocity then
        LinearVelocity:Destroy()
        LinearVelocity = nil
    end

    if AlignOrientation then
        AlignOrientation:Destroy()
        AlignOrientation = nil
    end

    if AntiGravity then
        AntiGravity:Destroy()
        AntiGravity = nil
    end

    if Attachment then
        Attachment:Destroy()
        Attachment = nil
    end

    CurrentCar = nil
    CurrentRoot = nil
end

-- ATIVAR VOO

local function startFlight()
    local car = getCar()

    if not car then
        return false, "Entre no carro primeiro"
    end

    local root = getRoot(car)

    if not root or not root:IsA("BasePart") then
        return false, "Nao encontrei a parte principal"
    end

    removeFlight()

    CurrentCar = car
    CurrentRoot = root

    Attachment = Instance.new("Attachment")
    Attachment.Name = "MiniFlightAttachment"
    Attachment.Parent = root

    -- MOVIMENTO

    LinearVelocity = Instance.new("LinearVelocity")
    LinearVelocity.Name = "MiniFlightVelocity"
    LinearVelocity.Attachment0 = Attachment
    LinearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    LinearVelocity.VelocityConstraintMode =
        Enum.VelocityConstraintMode.Vector
    LinearVelocity.VectorVelocity = Vector3.zero
    LinearVelocity.MaxForce = math.huge
    LinearVelocity.Parent = root

    -- ESTABILIZACAO: MANTER CARRO RETO

    AlignOrientation = Instance.new("AlignOrientation")
    AlignOrientation.Name = "MiniFlightStabilizer"
    AlignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    AlignOrientation.Attachment0 = Attachment
    AlignOrientation.CFrame = root.CFrame.Rotation
    AlignOrientation.RigidityEnabled = false
    AlignOrientation.Responsiveness = 30
    AlignOrientation.MaxTorque = math.huge
    AlignOrientation.Parent = root

    -- COMPENSAR GRAVIDADE DO CARRO

    AntiGravity = Instance.new("VectorForce")
    AntiGravity.Name = "MiniFlightAntiGravity"
    AntiGravity.Attachment0 = Attachment
    AntiGravity.RelativeTo = Enum.ActuatorRelativeTo.World
    AntiGravity.ApplyAtCenterOfMass = true
    AntiGravity.Force = Vector3.new(
        0,
        root.AssemblyMass * workspace.Gravity,
        0
    )
    AntiGravity.Parent = root

    LastLook = Vector3.new(
        root.CFrame.LookVector.X,
        0,
        root.CFrame.LookVector.Z
    )

    if LastLook.Magnitude > 0.01 then
        LastLook = LastLook.Unit
    else
        LastLook = Vector3.new(0, 0, -1)
    end

    return true, "Fly ativado"
end

local function stopFlight()
    Flying = false
    removeFlight()
end

local function toggleFlight()
    if Flying then
        stopFlight()
        return "Fly desativado"
    end

    local success, message = startFlight()

    if success then
        Flying = true
    end

    return message
end

-- GRAVIDADE

local function toggleGravity()
    if GravityEnabled then
        workspace.Gravity = OriginalGravity
        GravityEnabled = false
        return "Gravidade restaurada"
    else
        OriginalGravity = workspace.Gravity
        workspace.Gravity = 0
        GravityEnabled = true
        return "Gravidade zerada"
    end
end

