status.TextColor3 = Color3.fromRGB(165, 165, 165)
status.TextSize = 9

label("CONFIGURAR ATALHOS", 10, 52, 185, 18).Font =
    Enum.Font.GothamBold

local KeyButtons = {}

local function makeKey(name, caption, y)
    label(caption, 10, y, 115, 22)

    local button = Instance.new("TextButton")
    button.Position = UDim2.fromOffset(145, y)
    button.Size = UDim2.fromOffset(45, 20)
    button.BackgroundColor3 = Color3.fromRGB(23, 23, 23)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Text = Keys[name].Name
    button.Font = Enum.Font.GothamBold
    button.TextSize = 10
    button.Parent = main

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 5)
    c.Parent = button

    KeyButtons[name] = button

    button.MouseButton1Click:Connect(function()
        if Capturing then
            KeyButtons[Capturing].Text = Keys[Capturing].Name
        end

        Capturing = name
        button.Text = "..."
        status.Text = "Pressione uma tecla..."
    end)
end

makeKey("GUI", "Abrir / fechar GUI", 73)
makeKey("Gravity", "Zerar gravidade", 96)
makeKey("Fly", "Fly Car", 119)

-- ARRASTAR

local dragging = false
local dragStart
local startPosition

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = main.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart

        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- TECLAS

UIS.InputBegan:Connect(function(input, processed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    if Capturing then
        local name = Capturing
        local newKey = input.KeyCode

        local reserved = {
            [Enum.KeyCode.W] = true,
            [Enum.KeyCode.A] = true,
            [Enum.KeyCode.S] = true,
            [Enum.KeyCode.D] = true,
            [Enum.KeyCode.Space] = true,
            [Enum.KeyCode.LeftControl] = true,
            [Enum.KeyCode.RightControl] = true
        }

        if newKey == Enum.KeyCode.Unknown or reserved[newKey] then
            KeyButtons[name].Text = Keys[name].Name
            Capturing = nil
            status.Text = "Tecla reservada para voo"
            return
        end

        for otherName, otherKey in pairs(Keys) do
            if otherName ~= name and otherKey == newKey then
                KeyButtons[name].Text = Keys[name].Name
                Capturing = nil
                status.Text = "Tecla ja utilizada"
                return
            end
        end

        Keys[name] = newKey
        KeyButtons[name].Text = newKey.Name
        Capturing = nil
        status.Text = "Atalho atualizado"
        return
    end

    if processed or UIS:GetFocusedTextBox() then return end

    if input.KeyCode == Keys.GUI then
        main.Visible = not main.Visible

    elseif input.KeyCode == Keys.Gravity then
        status.Text = toggleGravity()

    elseif input.KeyCode == Keys.Fly then
        status.Text = toggleFlight()
    end
end)

-- CONTROLE DE VOO PELA CAMERA

RunService.RenderStepped:Connect(function()
    if not Flying then return end

    if not CurrentRoot or not CurrentRoot.Parent then
        stopFlight()
        status.Text = "Carro perdido"
        return
    end

    if getCar() ~= CurrentCar then
        stopFlight()
        status.Text = "Voando desativado"
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then return end

    local look = camera.CFrame.LookVector
    local right = camera.CFrame.RightVector

    local horizontalLook = Vector3.new(look.X, 0, look.Z)

    if horizontalLook.Magnitude > 0.01 then
        LastLook = horizontalLook.Unit
    end

    -- DIRECAO HORIZONTAL DA CAMERA

    local forward = look
    local side = right

    local movement = Vector3.zero

    if UIS:IsKeyDown(Enum.KeyCode.W) then
        movement += forward
    end

    if UIS:IsKeyDown(Enum.KeyCode.S) then
        movement -= forward
    end

    if UIS:IsKeyDown(Enum.KeyCode.D) then
        movement += side
    end

    if UIS:IsKeyDown(Enum.KeyCode.A) then
        movement -= side
    end

    if UIS:IsKeyDown(Enum.KeyCode.Space) then
        movement += Vector3.yAxis
    end

    if UIS:IsKeyDown(Enum.KeyCode.LeftControl)
        or UIS:IsKeyDown(Enum.KeyCode.RightControl) then
        movement -= Vector3.yAxis
    end

    if movement.Magnitude > 1 then
        movement = movement.Unit
    end

    LinearVelocity.VectorVelocity = movement * FlySpeed

    -- MANTER O CARRO NIVELADO
    -- Usa somente a rotacao horizontal da camera.
    -- Nao copia a inclinacao vertical da camera.

    local target = CFrame.lookAt(
        Vector3.zero,
        LastLook,
        Vector3.yAxis
    )

    AlignOrientation.CFrame = target

    -- ATUALIZAR COMPENSACAO DA GRAVIDADE

    AntiGravity.Force = Vector3.new(
        0,
        CurrentRoot.AssemblyMass * workspace.Gravity,
        0
    )
end)

-- LIMPEZA

Player.CharacterAdded:Connect(function()
    stopFlight()

    if GravityEnabled then
        workspace.Gravity = OriginalGravity
        GravityEnabled = false
    end
end)

gui.Destroying:Connect(function()
    stopFlight()

    if GravityEnabled then
        workspace.Gravity = OriginalGravity
        GravityEnabled = false
    end
end)
