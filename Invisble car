local function makeRow(text, yPos)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -20, 0, 30)
    row.Position = UDim2.new(0, 10, 0, yPos)
    row.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    row.BorderSizePixel = 0
    row.Parent = Main
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -50, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.Gotham
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(210, 210, 210)
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 40, 0, 20)
    btn.Position = UDim2.new(1, -50, 0, 5)
    btn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamBold
    btn.Text = "OFF"
    btn.TextColor3 = Color3.fromRGB(230, 230, 230)
    btn.TextSize = 12
    btn.Parent = row
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    return row, btn
end

local function bindToggle(btn, key)
    local function refresh()
        if Config.ESP[key] then
            btn.Text = "ON"
            btn.BackgroundColor3 = Color3.fromRGB(60, 180, 90)
        else
            btn.Text = "OFF"
            btn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
        end
    end
    refresh()
    btn.MouseButton1Click:Connect(function()
        Config.ESP[key] = not Config.ESP[key]
        refresh()
    end)
end

