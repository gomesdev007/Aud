local function onPlayerAdded(p) createESPFor(p) end
local function onPlayerRemoving(p) removeESPFor(p) end
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, p in ipairs(Players:GetPlayers()) do createESPFor(p) end

-- Car scan
local function scanCars()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("VehicleSeat") then
            local model = v:FindFirstAncestorOfClass("Model")
            if model then createCarESPFor(model) end
        end
    end
end
scanCars()
workspace.DescendantAdded:Connect(function(v)
    if v:IsA("VehicleSeat") then
        local model = v:FindFirstAncestorOfClass("Model")
        if model then createCarESPFor(model) end
    end
end)

