
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local guiName = "OriginalCarInvisible"
local enabled = false
local originalCar = nil
local saved = {}

local old = player.PlayerGui:FindFirstChild(guiName)
if old then old:Destroy() end

-- Encontrar somente o carro original do jogador
local function findMyCar()
    local cars = workspace:FindFirstChild("Cars")
    if not cars then return nil end

    for _, car in ipairs(cars:GetChildren()) do
        local stats = car:FindFirstChild("Stats")
        local owner = stats and stats:FindFirstChild("Owner")

        if owner then
            if (owner:IsA("StringValue") and owner.Value == player.Name)
            or (owner:IsA("ObjectValue") and owner.Value == player) then
                return car
            end
        end
    end

    return nil
end

-- Esconder exclusivamente as peças do carro original
local function hideCar(car)
    if not car then return end

    for _, obj in ipairs(car:GetDescendants()) do
        if obj:IsA("BasePart") then
            if saved[obj] == nil then
                saved[obj] = {
                    transparency = obj.LocalTransparencyModifier
                }
            end

            obj.LocalTransparencyModifier = 1

        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            if saved[obj] == nil then
                saved[obj] = {
                    transparency = obj.Transparency
                }
            end

            obj.Transparency = 1
        end
    end
end

-- Restaurar valores originais
local function restoreCar()
    for obj, data in pairs(saved) do
        if obj and obj.Parent then
            if obj:IsA("BasePart") then
                obj.LocalTransparencyModifier = data.transparency
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = data.transparency
            end
        end
    end

    table.clear(saved)
    originalCar = nil
end

-- Interface
local gui = Instance.new("ScreenGui")
gui.Name = guiName
gui.ResetOnSpawn = false
gui.Parent = player.PlayerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(165, 60)
frame.Position = UDim2.new(0.5, -82, 0.5, -30)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 23)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui

Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(65, 65, 70)
stroke.Parent = frame

local button = Instance.new("TextButton")
button.Size = UDim2.new(1, -12, 1, -12)
button.Position = UDim2.fromOffset(6, 6)
button.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
button.TextColor3 = Color3.new(1, 1, 1)
button.Text = "ORIGINAL: OFF"
button.TextSize = 12
button.Font = Enum.Font.GothamBold
button.BorderSizePixel = 0
button.Parent = frame

Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)

button.MouseButton1Click:Connect(function()
    if not enabled then
        local car = findMyCar()

        if not car then
            button.Text = "CARRO NÃO ENCONTRADO"
            task.wait(1)
            button.Text = "ORIGINAL: OFF"
            return
        end

        enabled = true
        originalCar = car
        hideCar(originalCar)

        button.Text = "ORIGINAL: ON"
        button.BackgroundColor3 = Color3.fromRGB(35, 110, 65)
    else
        enabled = false
        restoreCar()

        button.Text = "ORIGINAL: OFF"
        button.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
    end
end)

-- Esconde novas peças que forem adicionadas ao carro original,
-- sem tocar em modelos externos.
task.spawn(function()
    while gui.Parent do
        task.wait(0.5)

        if enabled then
            if not originalCar or not originalCar.Parent then
                enabled = false
                restoreCar()
                button.Text = "ORIGINAL: OFF"
                button.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
            else
                hideCar(originalCar)
            end
        end
    end
end)
