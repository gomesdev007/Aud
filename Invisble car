--============================================================
-- DRAWING UTILS
--============================================================
local Drawings = {}
local function newDrawing(class, props)
    local ok, obj = pcall(function()
        local d = Drawing.new(class)
        for k, v in pairs(props) do d[k] = v end
        return d
    end)
    if ok and obj then
        table.insert(Drawings, obj)
        return obj
    end
    return nil
end

local function clearDrawings()
    for _, d in ipairs(Drawings) do
        pcall(function() d:Remove() end)
    end
    Drawings = {}
end

--============================================================
-- ESP DATA PER PLAYER
--============================================================
local ESPData = {}

local function createESPFor(player)
    if player == LocalPlayer then return end
    if ESPData[player] then return end
    ESPData[player] = {
        Box = newDrawing("Square", {Thickness = 1, Color = Color3.fromRGB(255,255,255), Filled = false, Visible = false}),
        Name = newDrawing("Text", {Size = 14, Color = Color3.fromRGB(255,255,255), Center = true, Outline = true, Visible = false}),
        Health = newDrawing("Line", {Thickness = 2, Color = Color3.fromRGB(0,255,0), Visible = false}),
        Distance = newDrawing("Text", {Size = 12, Color = Color3.fromRGB(200,200,200), Center = true, Outline = true, Visible = false}),
        Line = newDrawing("Line", {Thickness = 1, Color = Color3.fromRGB(255,255,255), Visible = false}),
    }
end

local function removeESPFor(player)
    local data = ESPData[player]
    if not data then return end
    for _, d in pairs(data) do
        pcall(function() d:Remove() end)
    end
    ESPData[player] = nil
end

--============================================================
-- CAR ESP (uses vehicle seat)
--============================================================
local CarESP = {}
local function createCarESPFor(vehicle)
    if CarESP[vehicle] then return end
    CarESP[vehicle] = {
        Box = newDrawing("Square", {Thickness = 1, Color = Color3.fromRGB(255,180,0), Filled = false, Visible = false}),
        Name = newDrawing("Text", {Size = 13, Color = Color3.fromRGB(255,180,0), Center = true, Outline = true, Visible = false}),
    }
end

--============================================================
-- HELPER: get world-to-screen bbox
--============================================================
local function getBoundingBox(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not hrp or not head or not humanoid or humanoid.Health <= 0 then return nil end

    local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
    if not onScreen then return nil end

    local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
    local footPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

    local height = math.abs(headPos.Y - footPos.Y)
    local width = height * 0.6
    return Vector2.new(hrpPos.X - width / 2, hrpPos.Y - height / 2), Vector2.new(width, height), hrpPos
end

--============================================================
-- ESP UPDATE LOOP
--============================================================
RunService.RenderStepped:Connect(function()
    clearDrawings = clearDrawings -- keep reference

    for player, data in pairs(ESPData) do
        if not player.Parent or player == LocalPlayer then
            removeESPFor(player)
            continue
        end

        local char = player.Character
        local allHidden = not Config.ESP.Enabled

        if allHidden or not char then
            for _, d in pairs(data) do d.Visible = false end
            continue
        end

        if Config.ESP.TeamCheck and player.Team == LocalPlayer.Team then
            for _, d in pairs(data) do d.Visible = false end
            continue
        end

        local topLeft, size, center = getBoundingBox(char)
        if not topLeft then
            for _, d in pairs(data) do d.Visible = false end
            continue
        end

        local screenSize = Camera.ViewportSize

        -- BOX
        if Config.ESP.Box then
            data.Box.Visible = true
            data.Box.Size = size
            data.Box.Position = topLeft
            data.Box.Color = Color3.fromRGB(255, 60, 60)
        else
            data.Box.Visible = false
        end

        -- NAME
        if Config.ESP.Name then
            data.Name.Visible = true
            data.Name.Text = player.Name
            data.Name.Position = Vector2.new(center.X, topLeft.Y - 16)
        else
            data.Name.Visible = false
        end

        -- LINE
        if Config.ESP.Line then
            data.Line.Visible = true
            data.Line.From = Vector2.new(screenSize.X / 2, screenSize.Y)
            data.Line.To = Vector2.new(center.X, center.Y)
            data.Line.Color = Color3.fromRGB(255, 60, 60)
        else
            data.Line.Visible = false
        end

        -- HEALTH
        if Config.ESP.Health then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                local pct = hum.Health / hum.MaxHealth
                data.Health.Visible = true
                data.Health.From = Vector2.new(topLeft.X - 5, topLeft.Y + size.Y)
                data.Health.To = Vector2.new(topLeft.X - 5, topLeft.Y + size.Y * (1 - pct))
                local c = Color3.fromRGB(255 * (1 - pct), 255 * pct, 0)
                data.Health.Color = c
            end
        else
            data.Health.Visible = false
        end

        -- DISTANCE
        if Config.ESP.Distance then
            local dist = (Camera.CFrame.Position - char.HumanoidRootPart.Position).Magnitude
            data.Distance.Visible = true
            data.Distance.Text = string.format("[%d]", math.floor(dist))
            data.Distance.Position = Vector2.new(center.X, topLeft.Y + size.Y + 2)
        else
            data.Distance.Visible = false
        end
    end

    -- Car ESP
    for vehicle, data in pairs(CarESP) do
        if not vehicle.Parent or not Config.ESP.Enabled or not Config.ESP.Cars then
            data.Box.Visible = false
            data.Name.Visible = false
            continue
        end
        local seat = vehicle:FindFirstChildOfClass("VehicleSeat") or vehicle.PrimaryPart
        if not seat then
            data.Box.Visible = false
            data.Name.Visible = false
            continue
        end
        local pos, onScreen = Camera:WorldToViewportPoint(seat.Position)
        if not onScreen then
            data.Box.Visible = false
            data.Name.Visible = false
            continue
        end
        local size = Vector2.new(60, 60)
        local tl = Vector2.new(pos.X - size.X / 2, pos.Y - size.Y / 2)
        data.Box.Visible = true
        data.Box.Size = size
        data.Box.Position = tl
        data.Name.Visible = true
        data.Name.Text = "CAR"
        data.Name.Position = Vector2.new(pos.X, tl.Y - 16)
    end
end)

