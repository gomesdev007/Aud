local function GetEggState()
    local ok, mod = pcall(function()
        return require(game:GetService("ReplicatedStorage").Client.EggState)
    end)
    if ok and type(mod) == "table" then return mod end

    local rs     = game:GetService("ReplicatedStorage")
    local client = rs:FindFirstChild("Client")
    local mod    = client and client:FindFirstChild("EggState")
    if mod and mod:IsA("ModuleScript") then
        local ok2, mod2 = pcall(require, mod)
        if ok2 and type(mod2) == "table" then return mod2 end
    end
    return nil
end

local function DropFieldEgg(reason)
    local es = GetEggState()
    if not es or type(es.DropFieldEgg) ~= "function" then
        return false
    end
    return pcall(es.DropFieldEgg, reason or "PlayerRequest")
end

