-- ╔══════════════════════════════════════════════════════════════╗
-- ║ ANTI GUARD HOOK                                               ║
-- ║ Arma listener de RagdollEndTime. Se o player tomar ragdoll    ║
-- ║ durante o voo, teletransporta direto pro destino.             ║
-- ╚══════════════════════════════════════════════════════════════╝
local function ArmHitTeleport(destination)
    if not CONFIG.AntiGuardHook then return end

    STATE.HitArms      += 1
    STATE.HitArmedAt    = os.clock()
    STATE.PendingTarget = destination

    local landed = false
    local link
    link = LocalPlayer:GetAttributeChangedSignal("RagdollEndTime"):Connect(function()
        if landed then return end

        local num = tonumber(LocalPlayer:GetAttribute("RagdollEndTime"))
        if not num or num <= workspace:GetServerTimeNow() then return end

        local hrp = GetRoot()
        if not hrp then return end

        landed = true
        pc(function() link:Disconnect() end)

        pc(function()
            hrp.CFrame = CFrame.new(destination)
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)

        STATE.PendingTarget = nil
        STATE.HitArms = math.max(0, STATE.HitArms - 1)
    end)

    task.delay(CONFIG.HitArmsTimeout, function()
        if not landed then
            pc(function() link:Disconnect() end)
            STATE.HitArms = math.max(0, STATE.HitArms - 1)
        end
    end)
end

-- ╔══════════════════════════════════════════════════════════════╗
-- ║ STOP FLIGHT                                                   ║
-- ╚══════════════════════════════════════════════════════════════╝
function StopFlight()
    STATE.CancelFlag = true

    if STATE.HB then
        pc(function() STATE.HB:Disconnect() end)
        STATE.HB = nil
    end
    if STATE.Pre then
        pc(function() STATE.Pre:Disconnect() end)
        STATE.Pre = nil
    end
    if STATE.GodConn then
        pc(function() STATE.GodConn:Disconnect() end)
        STATE.GodConn = nil
    end

    pc(function()
        local hrp = GetRoot()
        if hrp then
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end)

    STATE.Flying = false
end

-- ╔══════════════════════════════════════════════════════════════╗
-- ║ FLYTO (versão base — Parte 5 vai sobrescrever)                ║
-- ║ 3 etapas: subir → deslocar → descer                            ║
-- ║ Heartbeat    → CFrame + rotação preservada                     ║
-- ║ PreSimulation → Velocity com gravidade compensada              ║
-- ║ Anti-stuck: se travar por 0.4s, nudge manual via CFrame        ║
-- ╚══════════════════════════════════════════════════════════════╝
function FlyTo(targetPos)
    if STATE.Flying then return false, "já voando" end
    if typeof(targetPos) ~= "Vector3" then return false, "posição inválida" end

    local hrp, char = GetRoot()
    if not hrp or not char then return false, "sem character" end

    -- trava ownership (evita conflito com outros sistemas)
    if not ClaimMovement("flyto") then
        return false, "movement ocupado: " .. tostring(STATE.MoveOwner)
    end

    STATE.Flying     = true
    STATE.CancelFlag = false

    -- liga bypasses
    if CONFIG.GodMode then GodOn() end
    StartAntiRagdoll()
    ShieldStart()

    local speed     = CONFIG.FlySpeed
    local height    = CONFIG.FlyHeight
    local arrive    = CONFIG.ArriveRadius
    local timeoutAt = os.clock() + CONFIG.Timeout

    -- posição-alvo elevada (+FlyHeight no Y)
    local elevated = Vector3.new(targetPos.X, targetPos.Y + height, targetPos.Z)

    -- espera sair do ragdoll antes de começar
    local startWait = os.clock()
    while os.clock() - startWait < CONFIG.RagdollWaitMax do
        if not IsRagdolled() then break end
        RunService.Heartbeat:Wait()

        hrp, char = GetRoot()
        if not hrp then
            StopFlight()
            ReleaseMovement("flyto")
            return false, "perdeu character"
        end
    end

    -- uneequip tools (tool reseta CFrame)
    pc(function()
        local hum = GetHumanoid()
        if hum then hum:UnequipTools() end
    end)

    -- arma hook de hit no alvo final
    ArmHitTeleport(targetPos)

    -- ── TRAJETÓRIA 3 ETAPAS ───────────────────────────────────
    local stages = {
        Vector3.new(hrp.Position.X, elevated.Y, hrp.Position.Z),  -- 1) subir
        elevated,                                                  -- 2) mover
        targetPos,                                                 -- 3) descer
    }

    local stageIndex  = 1
    local currentGoal = stages[1]
    local velCtx      = {}  -- contexto do anti-stuck

    -- ── HEARTBEAT: CFrame ─────────────────────────────────────
    STATE.HB = RunService.Heartbeat:Connect(function(dt)
        if STATE.CancelFlag then StopFlight(); return end
        if os.clock() > timeoutAt then StopFlight(); return end

        local root = GetRoot()
        if not root then StopFlight(); return end
        if root.Parent ~= char then StopFlight(); return end

        local delta = currentGoal - root.Position
        local mag   = delta.Magnitude

        -- chegou na etapa → avança
        if mag <= arrive then
            stageIndex += 1
            if stageIndex > #stages then
                pc(function()
                    root.AssemblyLinearVelocity  = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end)
                StopFlight()
                return
            end
            currentGoal = stages[stageIndex]
            return
        end

        -- move
        local step   = math.min(speed * dt, mag)
        local newPos = root.Position + delta.Unit * step

        pc(function()
            local rot = root.CFrame.Rotation
            root.CFrame = CFrame.new(newPos) * rot
            root.AssemblyLinearVelocity  = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end)

    -- ── PRESIMULATION: Velocity com gravidade compensada ──────
    STATE.Pre = RunService.PreSimulation:Connect(function(dt)
        if STATE.CancelFlag then return end

        local root = GetRoot()
        if not root then return end

        local delta = currentGoal - root.Position
        local mag   = delta.Magnitude

        -- anti-stuck
        if mag > 2 then
            if not velCtx.mark then
                velCtx.mark  = mag
                velCtx.clock = 0
            end
            velCtx.clock += dt
            if velCtx.clock >= 0.4 then
                if velCtx.mark - mag < 0.5 then
                    pc(function()
                        root.CFrame = root.CFrame + delta.Unit * math.min(mag, speed * dt)
                    end)
                end
                velCtx.mark  = mag
                velCtx.clock = 0
            end
        else
            velCtx.mark = nil
        end

        -- velocidade direcional
        local n = math.max(dt, 0.004166666666666667)
        local v = Vector3.zero
        if mag > 0.01 then
            v = delta.Unit * math.min(speed, mag / n)
        end

        -- + gravidade compensada (evita cair)
        local finalVel = v + Vector3.new(0, workspace.Gravity * n * 0.5, 0)

        pc(function()
            root.AssemblyLinearVelocity  = finalVel
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end)

    -- god tick durante o voo
    if CONFIG.GodMode then
        STATE.GodConn = RunService.Heartbeat:Connect(GodTick)
    end

    return true
end

