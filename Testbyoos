-- ║ PROMPT DISCOVERY                                              ║
-- ╚══════════════════════════════════════════════════════════════╝
local function FindNearestCarryPrompt(range)
    range = range or CONFIG.PromptDetectRange
    local hrp = GetRoot()
    if not hrp then return nil, nil, nil end

    local bestPrompt, bestPart, bestDist = nil, nil, range

    for _, child in ipairs(workspace:GetChildren()) do
        if child.Name == "SmartPromptPart" and child:IsA("BasePart") then
            local cap = child:FindFirstChild("CarryAreaEgg")
            if cap and cap:IsA("ProximityPrompt") then
                local d = (child.Position - hrp.Position).Magnitude
                if d < bestDist then
                    bestDist   = d
                    bestPrompt = cap
                    bestPart   = child
                end
            end
        end
    end

    return bestPrompt, bestPart, bestDist
end

