-- ╔══════════════════════════════════════════════════════════════╗
-- ║ SHIELD — método 1: "Humanoid Swap"                            ║
-- ║ Clona o Humanoid, câmera vai pro clone, movimenta o original. ║
-- ║ Padrão Chilli pra impedir ragdoll/stun.                       ║
-- ╚══════════════════════════════════════════════════════════════╝
local ShieldSwap = {}

function ShieldSwap.Undo()
    for _, l in ipairs(STATE.SwapLinks) do
        pc(function() l:Disconnect() end)
    end
    table.clear(STATE.SwapLinks)

    local char  = LocalPlayer.Character
    local orig  = STATE.SwapOriginal
    local clone = STATE.SwapClone
    STATE.SwapOriginal = nil
    STATE.SwapClone    = nil

    if orig and clone and char and orig.Parent == nil and clone.Parent == char then
        -- devolve o humanoid original ao character
        orig.Parent = char
        pc(function() workspace.CurrentCamera.CameraSubject = orig end)

        -- reconecta o PlayerModule ao humanoid original
        pc(function()
            local ps = LocalPlayer:FindFirstChild("PlayerScripts")
            local pm = ps and ps:FindFirstChild("PlayerModule")
            if pm then
                local ctrl = require(pm):GetControls()
                if type(ctrl) == "table" then ctrl.humanoid = orig end
            end
        end)

        -- destrói o clone
        pc(function() clone:Destroy() end)

        -- força reload do Animate
        pc(function()
            local an = char:FindFirstChild("Animate")
            if an and an:IsA("LocalScript") then
                task.spawn(function()
                    an.Enabled = false
                    task.wait()
                    an.Enabled = true
                end)
            end
        end)
    end
end

-- verifica se está no chão (swap no ar trava animação)
local function Grounded(hum)
    if not hum then hum = GetHumanoid() end
    if not hum or hum.Health <= 0 or hum.FloorMaterial == Enum.Material.Air then
        return false
    end
    local s = hum:GetState()
    return s == Enum.HumanoidStateType.Running
        or s == Enum.HumanoidStateType.RunningNoPhysics
        or s == Enum.HumanoidStateType.Landed
end

function ShieldSwap.Swap()
    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    if STATE.SwapClone and STATE.SwapClone.Parent == char then return end
    if not Grounded(hum) then return end

    -- clona o humanoid
    local clone = hum:Clone()
    hum.Parent  = nil
    clone.Parent = char
    workspace.CurrentCamera.CameraSubject = clone

    -- reconecta PlayerModule ao clone
    pc(function()
        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
        local pm = ps and ps:FindFirstChild("PlayerModule")
        if pm then
            local ctrl = require(pm):GetControls()
            if type(ctrl) == "table" then ctrl.humanoid = clone end
        end
    end)

    -- força reload do Animate
    pc(function()
        local an = char:FindFirstChild("Animate")
        if an and an:IsA("LocalScript") then
            task.spawn(function()
                an.Enabled = false
                task.wait()
                an.Enabled = true
            end)
        end
    end)

    STATE.SwapOriginal = hum
    STATE.SwapClone    = clone

    -- sincroniza WalkSpeed
    table.insert(STATE.SwapLinks,
        hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if clone.Parent ~= nil then
                clone.WalkSpeed = hum.WalkSpeed
            end
        end))

    -- replica animações no clone
    local a1 = hum:FindFirstChildOfClass("Animator")
    local a2 = clone:FindFirstChildOfClass("Animator")
    if a1 and a2 then
        table.insert(STATE.SwapLinks, a1.AnimationPlayed:Connect(function(track)
            local anim = track.Animation
            if not anim or clone.Parent == nil then return end

            local ok, loaded = pcall(function() return a2:LoadAnimation(anim) end)
            if not ok or not loaded then return end

            pc(function()
                loaded.Priority = track.Priority
                loaded.Looped   = track.Looped
                loaded:Play(0.05, math.max(track.WeightTarget, 0.01), track.Speed)
            end)

            local c = nil
            c = track.Stopped:Connect(function()
                pc(function() c:Disconnect() end)
                pc(function() loaded:Stop(0.1) end)
            end)
        end))
    end

    -- se o clone morrer, reseta tudo
    table.insert(STATE.SwapLinks, clone.Died:Connect(function()
        for _, l in ipairs(STATE.SwapLinks) do
            pc(function() l:Disconnect() end)
        end
        table.clear(STATE.SwapLinks)
        STATE.SwapOriginal = nil
        STATE.SwapClone    = nil

        local c2 = LocalPlayer.Character
        if c2 and hum.Parent == nil then
            hum.Parent = c2
            pc(function() workspace.CurrentCamera.CameraSubject = hum end)
        end

        pc(function() clone:Destroy() end)
        hum.Health = 0
    end))
end

function ShieldSwap.Active()
    local char = LocalPlayer.Character
    return STATE.SwapClone ~= nil
       and char ~= nil
       and STATE.SwapClone.Parent == char
end

-- ╔══════════════════════════════════════════════════════════════╗
-- ║ SHIELD — método 2: "Disable Monitor"                          ║
-- ║ Desabilita Heartbeats cujo source contém "UGI" (movement lock)║
-- ╚══════════════════════════════════════════════════════════════╝
local ShieldMon = {}

function ShieldMon.Disable()
    if type(getconnections) ~= "function" then return end
    for _, sig in ipairs({RunService.Heartbeat, RunService.PreSimulation, RunService.PostSimulation}) do
        local ok, conns = pcall(getconnections, sig)
        if not ok or type(conns) ~= "table" then continue end

        for _, conn in ipairs(conns) do
            local ok2, fn = pcall(function() return conn.Function end)
            if ok2 and type(fn) == "function" then
                local ok3, src = pcall(debug.info, fn, "s")
                if ok3 and string.find(tostring(src), "UGI", 1, true) then
                    local ok4, enabled = pcall(function() return conn.Enabled end)
                    if not ok4 or enabled ~= false then
                        if pcall(function() conn:Disable() end) then
                            table.insert(STATE.MonDisabled, conn)
                        end
                    end
                end
            end
        end
    end
end

function ShieldMon.Enable()
    for _, conn in ipairs(STATE.MonDisabled) do
        pc(function() conn:Enable() end)
    end
    table.clear(STATE.MonDisabled)
end

-- ╔══════════════════════════════════════════════════════════════╗
-- ║ SHIELD — controlador central                                  ║
-- ╚══════════════════════════════════════════════════════════════╝
local function ShieldStart()
    if CONFIG.Shield == "Off" then return end
    if STATE.SwapConn then return end

    local function tick()
        if STATE.ShieldPaused then return end
        if CONFIG.Shield == "Humanoid Swap" then
            ShieldSwap.Swap()
        else
            ShieldMon.Disable()
        end
    end

    tick()
    local acc = 0
    STATE.SwapConn = RunService.Heartbeat:Connect(function(dt)
        acc += dt
        local interval = CONFIG.Shield == "Humanoid Swap" and 0.25 or 3
        if acc >= interval then
            acc = 0
            tick()
        end
    end)
end

local function ShieldStop()
    if STATE.SwapConn then
        pc(function() STATE.SwapConn:Disconnect() end)
        STATE.SwapConn = nil
    end
    ShieldSwap.Undo()
    ShieldMon.Enable()
end

-- ╔══════════════════════════════════════════════════════════════╗
-- ║ GOD MODE                                                      ║
-- ║ States desabilitados + CanCollide false + BreakJointsOnDeath  ║
-- ╚══════════════════════════════════════════════════════════════╝
local GOD_STATES = {
    Enum.HumanoidStateType.FallingDown,
    Enum.HumanoidStateType.Ragdoll,
    Enum.HumanoidStateType.Physics,
    Enum.HumanoidStateType.Seated,
    Enum.HumanoidStateType.PlatformStanding,
}

local function GodOn()
    if STATE.GodOn then return end
    STATE.GodOn = true

    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then return end

    for _, s in ipairs(GOD_STATES) do
        pc(function() hum:SetStateEnabled(s, false) end)
    end
    pc(function() hum.BreakJointsOnDeath = false end)

    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and STATE.GodCollides[d] == nil then
            STATE.GodCollides[d] = d.CanCollide
            pc(function() d.CanCollide = false end)
        end
    end
end

local function GodOff()
    if not STATE.GodOn then return end
    STATE.GodOn = false

    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _, s in ipairs(GOD_STATES) do
            pc(function() hum:SetStateEnabled(s, true) end)
        end
    end

    for part, can in pairs(STATE.GodCollides) do
        if part and part.Parent then
            pc(function() part.CanCollide = can end)
        end
    end
    table.clear(STATE.GodCollides)
end

local function GodTick()
    local hum = GetHumanoid()
    if hum and hum.Health > 0 and hum.Health < hum.MaxHealth then
        pc(function() hum.Health = hum.MaxHealth end)
    end
end

-- ╔══════════════════════════════════════════════════════════════╗
-- ║ ANTI RAGDOLL                                                  ║
-- ║ RemoteEvent + RagdollEndTime + scan de Constraints            ║
-- ╚══════════════════════════════════════════════════════════════╝
local function IsRagdolled()
    -- 1) attribute RagdollEndTime
    local num = tonumber(LocalPlayer:GetAttribute("RagdollEndTime"))
    if num and num > workspace:GetServerTimeNow() then return true end

    -- 2) estado do humanoid
    local hum = GetHumanoid()
    if hum then
        local st = hum:GetState()
        return st == Enum.HumanoidStateType.Physics
            or st == Enum.HumanoidStateType.Ragdoll
            or st == Enum.HumanoidStateType.FallingDown
    end
    return false
end

local function ClearRagdoll()
    local char = LocalPlayer.Character
    if not char then return end

    -- 1) destrói constraints de ragdoll
    for _, d in ipairs(char:GetDescendants()) do
        if d.ClassName == "BallSocketConstraint"
        or d.ClassName == "NoCollisionConstraint"
        or d.ClassName == "HingeConstraint" then
            pc(function() d:Destroy() end)
        end
    end

    -- 2) re-habilita juntas
    for _, d in ipairs(char:GetDescendants()) do
        if (d:IsA("Motor6D") or d:IsA("AnimationConstraint")) and not d.Enabled then
            pc(function() d.Enabled = true end)
        end
    end

    -- 3) força Running
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pc(function()
            if hum.PlatformStand then hum.PlatformStand = false end
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end)
    end

    -- 4) reseta camera subject
    local cam = workspace.CurrentCamera
    if cam and hum and cam.CameraSubject ~= hum then
        pc(function() cam.CameraSubject = hum end)
    end
end

local function StartAntiRagdoll()
    if not CONFIG.AntiRagdoll then return end

    -- hook no RemoteEvent de ragdoll (se existir)
    local remote = ReplicatedStorage:FindFirstChild("Packages")
    remote = remote and remote:FindFirstChild("Networking")
    remote = remote and remote:FindFirstChild("RE/Ragdoll/ClientRagdoll")
    if remote and remote:IsA("RemoteEvent") then
        table.insert(STATE.AntiRagLinks, remote.OnClientEvent:Connect(function()
            task.defer(function()
                ClearRagdoll()
                STATE.AntiRagLast = os.clock()
            end)
        end))
    end

    -- escuta attribute RagdollEndTime
    table.insert(STATE.AntiRagLinks,
        LocalPlayer:GetAttributeChangedSignal("RagdollEndTime"):Connect(function()
            local num = tonumber(LocalPlayer:GetAttribute("RagdollEndTime"))
            if num and num > workspace:GetServerTimeNow() then
                STATE.AntiRagLast = os.clock()
                task.defer(ClearRagdoll)
            end
        end))

    -- monitor contínuo
    STATE.AntiRagConn = RunService.Heartbeat:Connect(function()
        if IsRagdolled() then
            if os.clock() - STATE.AntiRagLast > 0.15 then
                STATE.AntiRagLast = os.clock()
                ClearRagdoll()
            end
        end
    end)
end

local function StopAntiRagdoll()
    for _, l in ipairs(STATE.AntiRagLinks) do
        pc(function() l:Disconnect() end)
    end
    table.clear(STATE.AntiRagLinks)

    if STATE.AntiRagConn then
        pc(function() STATE.AntiRagConn:Disconnect() end)
        STATE.AntiRagConn = nil
    end
end
