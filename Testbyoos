-- ║ UID EXTRACTION                                                ║
-- ╚══════════════════════════════════════════════════════════════╝
local function ExtractUIDFromPrompt(prompt, part)
    local uid = nil

    if prompt then
        pcall(function()
            uid = prompt:GetAttribute("Uid")
                or prompt:GetAttribute("UID")
                or prompt:GetAttribute("EggUid")
        end)
    end
    if not uid and part then
        pcall(function()
            uid = part:GetAttribute("Uid")
                or part:GetAttribute("UID")
                or part:GetAttribute("EggUid")
                or part:GetAttribute("Owner")
        end)
    end
    if not uid and part then
        local parent = part.Parent
        if parent then
            local n = parent.Name
            if string.find(n, "FirstAreaEgg_") or #n > 20 then
                uid = n
            end
        end
    end

    return uid and tostring(uid) or nil
end

