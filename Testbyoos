-- ╚══════════════════════════════════════════════════════════════╝
local function RecordPrompt(prompt, part, dist, source)
    local realUid = ExtractUIDFromPrompt(prompt, part) or ("anon_" .. tostring(os.time()))

    STATE.DropCycle.Prompts[tostring(realUid)] = {
        Prompt   = prompt,
        Part     = part,
        SavedAt  = os.clock(),
        Name     = prompt and prompt.Name or "?",
        Distance = dist,
        Source   = source or "auto",
    }
    STATE.DropCycle.LastUID = tostring(realUid)
    STATE.DropCycle.PromptsDone[tostring(realUid)] = true

    print(string.format("[FlyTo] Prompt salvo (%s) → UID: %s  (%.1f studs)",
        source or "auto", tostring(realUid), dist or 0))

    return realUid
end

-- ╔══════════════════════════════════════════════════════════════╗
-- ║ LISTENER GLOBAL — manual                                      ║
-- ╚══════════════════════════════════════════════════════════════╝
local function StartGlobalPromptListener()
    if STATE.DropCycle.GlobalConn then return end

    STATE.DropCycle.GlobalConn = ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
        if player ~= LocalPlayer then return end
        if not CONFIG.AllowManual then return end
        if not STATE.DropCycle.WaitPrompt then return end
        if prompt.Name ~= "CarryAreaEgg" then return end

        local part = prompt.Parent
        if part and part.Name ~= "SmartPromptPart" then
            part = part.Parent
        end

        local hrp = GetRoot()
        local dist = 0
        if hrp and part and part:IsA("BasePart") then
            dist = (part.Position - hrp.Position).Magnitude
        end

        RecordPrompt(prompt, part, dist, "manual")

        if STATE.DropCycle.WaitResolve then
            local resolve = STATE.DropCycle.WaitResolve
            STATE.DropCycle.WaitResolve = nil
            pc(resolve)
        end
    end)
end

local function StopGlobalPromptListener()
    if STATE.DropCycle.GlobalConn then
        pc(function() STATE.DropCycle.GlobalConn:Disconnect() end)
        STATE.DropCycle.GlobalConn = nil
    end
end

-- ╔══════════════════════════════════════════════════════════════╗
-- ║ AUTO COMPLETE PROMPT                                          ║
-- ╚══════════════════════════════════════════════════════════════╝
local function AutoCompletePrompt()
    local prompt, part, dist = FindNearestCarryPrompt()
    if not prompt then
        return false, "nenhum CarryAreaEgg no raio"
    end

    pcall(function() prompt.HoldDuration = 0 end)

    local ok = false
    if type(fireproximityprompt) == "function" then
        ok = pcall(fireproximityprompt, prompt)
    end
    if not ok then
        ok = pcall(function()
            prompt:InputHoldBegin()
            task.wait(0.05)
            prompt:InputHoldEnd()
        end)
    end
    if not ok then
        return false, "falha ao disparar prompt"
    end

    local realUid = RecordPrompt(prompt, part, dist, "auto")
    return true, realUid
end

-- ╔══════════════════════════════════════════════════════════════╗
-- ║ WAIT + AUTO/MANUAL COMPLETE                                   ║
-- ╚══════════════════════════════════════════════════════════════╝
local function WaitAndCompletePrompt()
    STATE.DropCycle.WaitPrompt = true

    local deadline = os.clock() + CONFIG.PromptWaitTime
    local lastTry  = 0
    local got      = false
    local uid      = nil

    STATE.DropCycle.WaitResolve = function()
        got = true
        uid = STATE.DropCycle.LastUID
    end

    while os.clock() < deadline and not got do
        if STATE.CancelFlag then
            STATE.DropCycle.WaitPrompt  = false
            STATE.DropCycle.WaitResolve = nil
            return false, "cancelado"
        end

        if os.clock() - lastTry >= 0.3 then
            lastTry = os.clock()
            local ok, info = AutoCompletePrompt()
            if ok then
                got = true
                uid = info
                break
            end
        end

        RunService.Heartbeat:Wait()
    end

    STATE.DropCycle.WaitPrompt  = false
    STATE.DropCycle.WaitResolve = nil

    if got then
        task.wait(0.4)
    end

    return got, uid
end

-- ╔══════════════════════════════════════════════════════════════╗
-- ║ DROP CYCLE STEP (com freeze real)                             ║
-- ╚══════════════════════════════════════════════════════════════╝
local function DoDropCycle()
    STATE.DropCycle.Count += 1
    local n = STATE.DropCycle.Count

    print(string.format("[FlyTo] Drop #%d — congelando char", n))

    -- ⚡ CONGELA DE VERDADE (ancora todas as parts)
    FreezeRoot()

    -- espera 1s REALMENTE PARADO
    local pauseUntil = os.clock() + CONFIG.DropPauseTime
    while os.clock() < pauseUntil do
        RunService.Heartbeat:Wait()
        if STATE.CancelFlag then
            UnfreezeRoot()
            return false
        end
    end

    -- solta o remote (char congelado)
    local dropped = DropFieldEgg("PlayerRequest")
    print(string.format("[FlyTo] Drop #%d → remote %s", n, dropped and "ok" or "falhou"))

    task.wait(0.6)

    -- auto-completa OU espera manual (char continua congelado)
    local ok, uid = WaitAndCompletePrompt()
    if ok then
        print(string.format("[FlyTo] Retomando voo. UID: %s",
            tostring(uid or STATE.DropCycle.LastUID)))
    else
        print("[FlyTo] Timeout. Retomando mesmo assim.")
    end

    -- ⚡ DESCONGELA
    UnfreezeRoot()

    return true
end
--[[ Chilli FlyTo GUI — 5B/7 (CORRIGIDO: freeze instantâneo no gatilho)
     Redefine FlyTo com o ciclo de drop embutido (400 studs).
     Congela o char NO MESMO FRAME que detecta o gatilho.
]]

local BaseFlyTo = FlyTo

FlyTo = function(targetPos)
    if STATE.Flying then return false, "já voando" end
    if typeof(targetPos) ~= "Vector3" then return false, "posição inválida" end

    local hrp, char = GetRoot()
    if not hrp or not char then return false, "sem character" end

    if not ClaimMovement("flyto") then
        return false, "movement ocupado: " .. tostring(STATE.MoveOwner)
    end

    STATE.Flying     = true
    STATE.CancelFlag = false

    if CONFIG.GodMode then GodOn() end
    StartAntiRagdoll()
    ShieldStart()
    StartGlobalPromptListener()

    STATE.DropCycle.Active      = CONFIG.EnableDropCycle
    STATE.DropCycle.Count       = 0
    STATE.DropCycle.LastUID     = nil
    STATE.DropCycle.PromptsDone = {}

    local speed     = CONFIG.FlySpeed
    local height    = CONFIG.FlyHeight
    local arrive    = CONFIG.ArriveRadius
    local timeoutAt = os.clock() + CONFIG.Timeout

    local elevated = Vector3.new(targetPos.X, targetPos.Y + height, targetPos.Z)

    local startWait = os.clock()
    while os.clock() - startWait < CONFIG.RagdollWaitMax do
        if not IsRagdolled() then break end
        RunService.Heartbeat:Wait()
        hrp, char = GetRoot()
        if not hrp then
            StopFlight()
            ReleaseMovement("flyto")
            StopGlobalPromptListener()
            return false, "perdeu char"
        end
    end

    pc(function()
        local hum = GetHumanoid()
        if hum then hum:UnequipTools() end
    end)

    ArmHitTeleport(targetPos)

    local stages = {
        Vector3.new(hrp.Position.X, elevated.Y, hrp.Position.Z),
        elevated,
        targetPos,
    }

    local stageIndex   = 1
    local currentGoal  = stages[1]
    local velCtx       = {}
    local lastPosition = hrp.Position
    local accumulated  = 0
    local paused       = false

    -- ══ HEARTBEAT: CFrame ═════════════════════════════════════
    STATE.HB = RunService.Heartbeat:Connect(function(dt)
        if STATE.CancelFlag then
            StopFlight()
            StopGlobalPromptListener()
            return
        end
        if os.clock() > timeoutAt then
            StopFlight()
            StopGlobalPromptListener()
            return
        end

        -- parado: já está congelado, não move
        if paused then return end

        local root = GetRoot()
        if not root then
            StopFlight(); StopGlobalPromptListener(); return
        end
        if root.Parent ~= char then
            StopFlight(); StopGlobalPromptListener(); return
        end

        -- acumula distância
        local moved = (root.Position - lastPosition).Magnitude
        if moved > 0 and moved < 200 then
            accumulated += moved
        end
        lastPosition = root.Position

        -- ═══ GATILHO: 400 studs ═══
        if STATE.DropCycle.Active and accumulated >= CONFIG.DropEveryStuds then
            accumulated = 0
            paused      = true

            -- ⚡⚡ FREEZE IMEDIATO NO MESMO FRAME ⚡⚡
            -- Sem isso, o char desliza alguns studs pela inércia.
            FreezeRoot()

            task.spawn(function()
                -- DoDropCycle já chamaria FreezeRoot, mas chamamos antes pra
                -- garantir que o freeze aconteça no frame do gatilho
                pc(DoDropCycle)

                local r2, c2 = GetRoot()
                if r2 and c2 then
                    char         = c2
                    lastPosition = r2.Position

                    elevated    = Vector3.new(targetPos.X, targetPos.Y + height, targetPos.Z)
                    currentGoal = Vector3.new(r2.Position.X, elevated.Y, r2.Position.Z)
                    stageIndex  = 1
                end

                paused = false
            end)

            return
        end

        local delta = currentGoal - root.Position
        local mag   = delta.Magnitude

        if mag <= arrive then
            stageIndex += 1
            if stageIndex > #stages then
                pc(function()
                    root.AssemblyLinearVelocity  = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end)
                StopFlight()
                StopGlobalPromptListener()
                return
            end
            currentGoal = stages[stageIndex]
            return
        end

        local step   = math.min(speed * dt, mag)
        local newPos = root.Position + delta.Unit * step

        pc(function()
            local rot = root.CFrame.Rotation
            root.CFrame = CFrame.new(newPos) * rot
            root.AssemblyLinearVelocity  = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end)

    -- ══ PRESIMULATION: Velocity ═══════════════════════════════
    STATE.Pre = RunService.PreSimulation:Connect(function(dt)
        if STATE.CancelFlag then return end
        if paused then return end   -- parado não aplica velocity

        local root = GetRoot()
        if not root then return end

        local delta = currentGoal - root.Position
        local mag   = delta.Magnitude

        if mag > 2 then
            if not velCtx.mark then
                velCtx.mark  = mag
                velCtx.clock = 0
            end
            velCtx.clock += dt
            if velCtx.clock >= 0.4 then
                if velCtx.mark - mag < 0.5 then
                    pc(function()
                        root.CFrame = root.CFrame + delta.Unit * math.min(mag, speed * dt)
                    end)
                end
                velCtx.mark  = mag
                velCtx.clock = 0
            end
        else
            velCtx.mark = nil
        end

        local n = math.max(dt, 0.004166666666666667)
        local v = Vector3.zero
        if mag > 0.01 then
            v = delta.Unit * math.min(speed, mag / n)
        end
        local finalVel = v + Vector3.new(0, workspace.Gravity * n * 0.5, 0)

        pc(function()
            root.AssemblyLinearVelocity  = finalVel
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end)

    if CONFIG.GodMode then
        STATE.GodConn = RunService.Heartbeat:Connect(GodTick)
    end

    return true
end
