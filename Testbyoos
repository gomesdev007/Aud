-- ╔══════════════════════════════════════════════════════════════╗
-- ║ MOVEMENT OWNERSHIP (padrão Chilli tbl4.ClaimMovement)         ║
-- ║ Evita conflito entre módulos que tentam controlar o char.     ║
-- ╚══════════════════════════════════════════════════════════════╝
local function ClaimMovement(owner)
    if STATE.MoveOwner == nil or STATE.MoveOwner == owner then
        STATE.MoveOwner = owner
        return true
    end
    return false
end

local function ReleaseMovement(owner)
    if STATE.MoveOwner == owner then
        STATE.MoveOwner = nil
    end
end

-- ╔══════════════════════════════════════════════════════════════╗
-- ║ PERSISTÊNCIA                                                  ║
-- ║ Salva/carrega positions.json via readfile/writefile se existir║
-- ╚══════════════════════════════════════════════════════════════╝
local function HasFileAPI()
    return type(readfile)   == "function"
       and type(writefile)  == "function"
       and type(isfolder)   == "function"
       and type(makefolder) == "function"
       and type(isfile)     == "function"
end

local function LoadSaved()
    if not HasFileAPI() then return end
    pc(function()
        if not isfolder(CONFIG.FolderPath) then
            makefolder(CONFIG.FolderPath)
        end
        if isfile(CONFIG.SavePath) then
            local raw  = readfile(CONFIG.SavePath)
            local data = HttpService:JSONDecode(raw)
            if type(data) == "table" then
                STATE.Saved = data
            end
        end
    end)
end

local function PersistSaved()
    if not HasFileAPI() then return end
    pc(function()
        if not isfolder(CONFIG.FolderPath) then
            makefolder(CONFIG.FolderPath)
        end
        writefile(CONFIG.SavePath, HttpService:JSONEncode(STATE.Saved))
    end)
end

local function SaveCurrent(name)
    name = tostring(name or ""):gsub("^%s+",""):gsub("%s+$","")
    if name == "" then return false, "nome vazio" end

    local hrp = GetRoot()
    if not hrp then return false, "sem character" end

    local p = hrp.Position
    STATE.Saved[name] = { x = p.X, y = p.Y, z = p.Z }
    PersistSaved()
    return true
end
