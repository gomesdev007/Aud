-- ║ FREEZE / UNFREEZE                                             ║
-- ║ Ancora TODAS as BaseParts do char. Isso congela 100% — nem   ║
-- ║ física nem velocity residual movem o char.                    ║
-- ╚══════════════════════════════════════════════════════════════╝
local function FreezeRoot()
    local char = LocalPlayer.Character
    if not char then return end

    -- limpa tabela antes
    table.clear(STATE.DropCycle.FrozenParts)

    -- salva o estado original e ancora cada part
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") then
            local prev = {
                Anchored            = d.Anchored,
                CanCollide          = d.CanCollide,
                AssemblyLinearVel   = nil,
                AssemblyAngularVel  = nil,
            }
            pcall(function()
                prev.AssemblyLinearVel  = d.AssemblyLinearVelocity
                prev.AssemblyAngularVel = d.AssemblyAngularVelocity
            end)
            STATE.DropCycle.FrozenParts[d] = prev

            pc(function()
                d.AssemblyLinearVelocity  = Vector3.zero
                d.AssemblyAngularVelocity = Vector3.zero
                d.Anchored                = true
            end)
        end
    end

    -- trava o HumanoidRootPart por último (garantia)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        pc(function()
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.Anchored                = true
        end)
    end
end

local function UnfreezeRoot()
    for part, prev in pairs(STATE.DropCycle.FrozenParts) do
        if part and part.Parent then
            pc(function()
                part.Anchored   = prev.Anchored
                part.CanCollide = prev.CanCollide
                if prev.AssemblyLinearVel then
                    part.AssemblyLinearVelocity  = prev.AssemblyLinearVel
                end
                if prev.AssemblyAngularVel then
                    part.AssemblyAngularVelocity = prev.AssemblyAngularVel
                end
            end)
        end
    end
    table.clear(STATE.DropCycle.FrozenParts)
end

